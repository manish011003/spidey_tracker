{
  "rules": {
    ".read": false,
    ".write": false,
    "partnerAccess": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid",
        "partnerId": {
          ".validate": "newData.isString() || newData.val() == null"
        }
      }
    },
    "friendAccess": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        "$friendId": {
          ".write": "auth != null && auth.uid == $uid",
          ".validate": "newData.isBoolean() || !newData.exists()"
        }
      }
    },
    "presence": {
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('partnerAccess').child(auth.uid).child('partnerId').val() == $uid || root.child('friendAccess').child(auth.uid).child($uid).val() == true)",
        ".write": "auth != null && auth.uid == $uid",
        ".validate": "newData.hasChildren(['online', 'lastSeen', 'locationSharingEnabled'])",
        "latitude": { ".validate": "newData.isNumber() || newData.val() == null" },
        "longitude": { ".validate": "newData.isNumber() || newData.val() == null" },
        "online": { ".validate": "newData.isBoolean()" },
        "locationSharingEnabled": { ".validate": "newData.isBoolean()" },
        "preciseLocationEnabled": { ".validate": "newData.isBoolean()" },
        "accuracy": { ".validate": "newData.isNumber() || newData.val() == null" },
        "heading": { ".validate": "newData.isNumber() || newData.val() == null" },
        "speed": { ".validate": "newData.isNumber() || newData.val() == null" },
        "timestamp": { ".validate": "newData.isNumber() || newData.val() == null" },
        "lastSeen": { ".validate": true }
      }
    },
    "nudges": {
      "$toUid": {
        ".read": "auth != null && auth.uid == $toUid",
        ".write": "auth != null && ((!data.exists() && newData.child('fromUid').val() == auth.uid) || (data.exists() && auth.uid == $toUid))",
        ".validate": "newData.hasChildren(['fromUid', 'fromName', 'timestamp']) || !newData.exists()",
        "fromUid": { ".validate": "newData.isString()" },
        "fromName": { ".validate": "newData.isString()" },
        "timestamp": { ".validate": "newData.isNumber()" }
      }
    }
  }
}
